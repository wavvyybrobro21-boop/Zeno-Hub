local Utilities = {}

--- Check if character exists
function Utilities:GetCharacter()
    local player = game.Players.LocalPlayer
    if player and player.Character and player.Character:FindFirstChild("Humanoid") then
        return player.Character
    end
    return nil
end

--- Safe notification wrapper
function Utilities:Notify(title, content, duration)
    duration = duration or Config.NotificationDuration
    pcall(function()
        Rayfield:Notify({
            Title = title,
            Content = content,
            Duration = duration
        })
    end)
end

--- Validate character before action
function Utilities:SafeCharacterAction(callback)
    local char = self:GetCharacter()
    if not char then
        self:Notify("Error", "Character not found!", 3)
        return false
    end
    pcall(callback)
    return true
end

-- ============================================
-- Fly System
-- ============================================
local FlySystem = {}
FlySystem.Flying = false
FlySystem.Speed = 50

function FlySystem:Start()
    if self.Flying then
        self:Stop()
        return
    end
    
    Utilities:SafeCharacterAction(function()
        local char = game.Players.LocalPlayer.Character
        local humanoidRootPart = char:FindFirstChild("HumanoidRootPart")
        
        if not humanoidRootPart then return end
        
        self.Flying = true
        local BodyVelocity = Instance.new("BodyVelocity")
        BodyVelocity.Velocity = Vector3.new(0, 0, 0)
        BodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        BodyVelocity.Parent = humanoidRootPart
        
        local UserInputService = game:GetService("UserInputService")
        local RunService = game:GetService("RunService")
        
        local flyConnection
        flyConnection = RunService.RenderStepped:Connect(function()
            if not self.Flying then
                BodyVelocity:Destroy()
                flyConnection:Disconnect()
                return
            end
            
            local moveDirection = Vector3.new(0, 0, 0)
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDirection = moveDirection + (humanoidRootPart.CFrame.LookVector) end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDirection = moveDirection - (humanoidRootPart.CFrame.LookVector) end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDirection = moveDirection - (humanoidRootPart.CFrame.RightVector) end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDirection = moveDirection + (humanoidRootPart.CFrame.RightVector) end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDirection = moveDirection + Vector3.new(0, 1, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then moveDirection = moveDirection - Vector3.new(0, 1, 0) end
            
            BodyVelocity.Velocity = moveDirection.Unit * self.Speed + Vector3.new(0, 0, 0)
        end)
        
        Utilities:Notify("Flight", "Fly mode activated! Use WASD + Space/Ctrl to move", 2)
    end)
end

function FlySystem:Stop()
    self.Flying = false
    Utilities:Notify("Flight", "Fly mode deactivated", 2)
end

-- ============================================
-- Teleport System
-- ============================================
local TeleportLocations = {
    ["Spawn"] = Vector3.new(0, 3, 0),
    ["Secret Room"] = Vector3.new(100, 50, 100),
    ["Boss Area"] = Vector3.new(-100, 50, -100),
}

function Utilities:Teleport(location)
    self:SafeCharacterAction(function()
        local targetPos = TeleportLocations[location] or TeleportLocations["Spawn"]
        local char = game.Players.LocalPlayer.Character
        local rootPart = char:FindFirstChild("HumanoidRootPart")
        
        if rootPart then
            rootPart.CFrame = CFrame.new(targetPos + Vector3.new(0, 5, 0))
            self:Notify("Teleport", "Teleported to " .. location, 2)
        end
    end)
end

